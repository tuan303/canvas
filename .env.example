# Cấu hình kết nối Canvas cho api/canvas.js (Vercel: Project → Settings → Environment Variables;
# chạy cục bộ: chép thành .env cạnh server.js rồi `node server.js`). KHÔNG đưa file .env lên git.
# Bỏ trống CANVAS_BASE_URL = tắt tính năng "Gửi thẳng lên Canvas" (vẫn tải gói QTI về để import tay).

# Địa chỉ Canvas của trường, đúng dạng dùng để đăng nhập (chỉ https; http chỉ cho máy cục bộ)
CANVAS_BASE_URL=https://4015.instructure.com

# Developer Key (API Key) do quản trị Canvas tạo: Admin → Developer Keys → + Developer Key → API Key
#   Redirect URIs: https://<địa chỉ web>/api/canvas?op=callback   (chạy cục bộ: http://localhost:8787/api/canvas?op=callback)
#   Bật Enforce Scopes và chọn các scope trong docs/nghien-cuu/rest-api.md §5(b); lưu xong chuyển State = ON
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Chuỗi bí mật ngẫu nhiên (≥ 32 ký tự) để mã hoá cookie phiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi chuỗi này = mọi người phải đăng nhập lại.
SESSION_SECRET=

# =1: cho phép dán token truy cập cá nhân (Tài khoản → Cài đặt → + Token truy cập mới).
# CHỈ dùng chạy thử với một giáo viên — chính sách API của Canvas yêu cầu ứng dụng nhiều người dùng phải dùng OAuth.
ALLOW_PERSONAL_TOKEN=0

# (tuỳ chọn) Địa chỉ công khai của web, dùng để dựng redirect_uri khi tên miền khác với tên miền nhận yêu cầu.
# Bỏ trống = tự suy từ yêu cầu.
APP_URL=

# (tuỳ chọn) Ghi đè danh sách scope gửi lên Canvas (ngăn bằng dấu cách).
# none = không gửi scope (dùng khi Developer Key KHÔNG bật Enforce Scopes).
CANVAS_SCOPES=

# Chỉ dùng khi chạy cục bộ bằng server.js
PORT=8787
HOST=127.0.0.1
